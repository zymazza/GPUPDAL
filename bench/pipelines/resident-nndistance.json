{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "input.las"
    },
    {
      "type": "filters.nndistance",
      "k": 10
    },
    {
      "type": "filters.assign",
      "value": "UserData = 1 WHERE NNDistance >= 0.4"
    },
    {
      "type": "writers.las",
      "filename": "output.las"
    }
  ]
}
