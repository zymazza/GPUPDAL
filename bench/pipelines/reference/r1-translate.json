{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "input.laz"
    },
    {
      "type": "filters.crop",
      "bounds": "([REPLACE_MINX,REPLACE_MAXX],[REPLACE_MINY,REPLACE_MAXY])"
    },
    {
      "type": "filters.reprojection",
      "in_srs": "EPSG:28992",
      "out_srs": "EPSG:3857"
    },
    {
      "type": "writers.las",
      "filename": "output.laz",
      "compression": "true"
    }
  ]
}
