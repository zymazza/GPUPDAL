{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "input.las"
    },
    {
      "type": "filters.assign",
      "value": "Scratch = Intensity * 2"
    },
    {
      "type": "filters.expression",
      "expression": "Scratch <= 16000"
    },
    {
      "type": "filters.assign",
      "value": "Classification = 5 WHERE Scratch >= 0"
    },
    {
      "type": "filters.ferry",
      "dimensions": "Classification=>UserData"
    },
    {
      "type": "writers.las",
      "filename": "out.las"
    }
  ]
}
