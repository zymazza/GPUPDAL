{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "input.las"
    },
    {
      "type": "filters.assign",
      "value": "Scratch = Intensity * 2"
    },
    {
      "type": "filters.stats",
      "dimensions": "Scratch"
    },
    {
      "type": "filters.expression",
      "expression": "Scratch >= 100 && Scratch < 300"
    },
    {
      "type": "filters.assign",
      "value": "Classification = 5"
    },
    {
      "type": "writers.las",
      "filename": "out.las"
    }
  ]
}
