{
  "pipeline": [
    {
      "filename": "input.las",
      "type": "readers.las"
    },
    {
      "always_up": false,
      "knn": 5,
      "type": "filters.normal"
    },
    {
      "type": "filters.assign",
      "value": "GpsTime = sqrt(Intensity)"
    },
    {
      "knn": 5,
      "normalize": true,
      "type": "filters.eigenvalues"
    },
    {
      "extra_dims": "all",
      "filename": "out.las",
      "type": "writers.las"
    }
  ]
}
